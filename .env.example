# Supabase Configuration for RSVPs and Wishes Wall (Optional: falls back to localStorage if empty)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase SQL: RSVPs Table ───────────────────────────────────────────────
#
# CREATE TABLE public.rsvps (
#   id BIGSERIAL PRIMARY KEY,
#   guest_slug TEXT DEFAULT 'direct',
#   name TEXT NOT NULL,
#   phone TEXT NOT NULL,
#   attending BOOLEAN NOT NULL DEFAULT TRUE,
#   guests_count INTEGER NOT NULL DEFAULT 1,
#   message TEXT,
#   created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
# );
#
# ALTER TABLE public.rsvps ENABLE ROW LEVEL SECURITY;
#
# CREATE POLICY "Allow anonymous RSVP submission" ON public.rsvps
#   FOR INSERT WITH CHECK (true);
#
# CREATE POLICY "Allow authenticated read" ON public.rsvps
#   FOR SELECT USING (auth.role() = 'authenticated');


